# ============================================================
#  .env.example
#  این فایل را به .env کپی کنید و مقادیر واقعی را جایگزین کنید.
#  هرگز فایل .env واقعی را commit نکنید.
#
#  اپ در صورت نبود یا ضعیف بودن secret های حیاتی بالا نمی‌آید
#  (fail-fast) — هیچ مقدار پیش‌فرض ناامنی در کد وجود ندارد.
# ============================================================

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# تعداد پراکسی‌های جلوی اپ (nginx/ALB). روی rate limiting اثر دارد.
TRUST_PROXY_HOPS=1

# ── JWT (الزامی) ────────────────────────────────────────────
# حداقل ۳۲ کاراکتر در development و ۶۴ کاراکتر در production
# تولید: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h
# فقط اگر جریان refresh token را پیاده کردید
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ── MongoDB (الزامی) ────────────────────────────────────────
# در production حتماً با نام کاربری و رمز:
# mongodb://user:pass@host:27017/dbname?authSource=admin
MONGODB_URI=mongodb://localhost:27017/starter

# ── CORS ────────────────────────────────────────────────────
# لیست دامنه‌های مجاز، کاما-جدا. در production الزامی است و "*" مجاز نیست.
CORS_ORIGINS=http://localhost:3000

# ── Admin Panel ─────────────────────────────────────────────
# پیش‌فرض خاموش. مسیر ثابت /admin با لاگین واقعی محافظت می‌شود.
# اولین ادمین: npm run create-admin
ADMIN_PANEL_ENABLED=false
ADMIN_COOKIE_NAME=admin_session
# در production باید true باشد (cookie فقط روی HTTPS)
ADMIN_COOKIE_SECURE=false

# ── Security tuning ─────────────────────────────────────────
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
BCRYPT_ROUNDS=12
MAX_PAGE_SIZE=100

# ── AWS S3 (اختیاری — فقط اگر آپلود فایل فعال است) ──────────
# روی EC2/ECS با IAM Role، دو متغیر کلید را خالی بگذارید.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ── Firebase (اختیاری) ──────────────────────────────────────
# نیاز به: npm install firebase-admin
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Admin SDK — یکی از این دو (فایل باید در .gitignore باشد)
FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── Email (اختیاری) ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── OTP / SMS (اختیاری) ─────────────────────────────────────
SMS_API_KEY=
SMS_API_URL=

# ── Encryption (اختیاری) ────────────────────────────────────
# برای رمزنگاری داده‌های حساس در DB — ۳۲ بایت hex
ENCRYPTION_KEY=
